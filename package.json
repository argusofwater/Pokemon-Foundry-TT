{
  "name": "pokemon-foundry-tt-private-workspace",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Private development and validation tooling for the PTR 1e Foundry system.",
  "scripts": {
    "validate": "node tools/validate-system.mjs",
    "validate:strict": "node tools/validate-system.mjs --strict",
    "audit:commander-runtime": "node tools/audit-commander-runtime.mjs",
    "test:commander-progression": "node --test tools/commander/progression.test.mjs",
    "package": "node tools/package-system.mjs",
    "compendium:validate": "node tools/commander/validate-source.mjs",
    "compendium:build": "node tools/commander/build-compendiums.mjs",
    "compendium:import-legacy": "node tools/commander/import-legacy-export.mjs",
    "compendium:translate": "npm run compendium:translate-species && npm run compendium:translate-abilities && npm run compendium:translate-moves && npm run compendium:translate-items && npm run compendium:translate-learnsets",
    "compendium:translate-species": "node tools/commander/translate-species.mjs",
    "compendium:translate-abilities": "node tools/commander/translate-abilities.mjs",
    "compendium:translate-moves": "node tools/commander/translate-moves.mjs",
    "compendium:translate-items": "node tools/commander/translate-items.mjs",
    "compendium:translate-learnsets": "node tools/commander/translate-learnsets.mjs",
    "compendium:test-conversions": "node tools/commander/conversion-rules.test.mjs",
    "artwork:fetch-pokeapi": "node tools/commander/fetch-pokeapi-artwork.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=24"
  }
}
