<section class="commander-tab {{#unless (eq activeTab currentPart)}}hidden{{/unless}}" data-tab="{{currentPart}}">
  <header class="commander-section-header">
    <div>
      <h2>{{capitalize currentPart}}</h2>
      <p>This section is now wired into the Commander sheet and ready for its dedicated controls.</p>
    </div>
  </header>
  <div class="commander-card">
    <h3>{{capitalize currentPart}}</h3>
    <p>The tab now replaces the previous tab correctly instead of stacking content. Dedicated fields and automation will be added here as this section is implemented.</p>
  </div>
</section>
